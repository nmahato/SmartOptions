# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database
DB_ENGINE=postgres
DB_NAME=smartoptions
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# If you use the Docker Compose Postgres service instead of an installed
# local PostgreSQL service, set DB_PORT=5433 on the host.

# To use SQLite instead of local Postgres:
# DB_ENGINE=sqlite
# SQLITE_NAME=backend/db.sqlite3

# Redis
REDIS_URL=redis://localhost:6379/0

# API Keys (Optional)
ALPHA_VANTAGE_API_KEY=your-api-key
YAHOO_FINANCE_API_KEY=your-api-key
FINNHUB_API_KEY=your-api-key
